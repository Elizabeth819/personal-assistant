# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
PA_MODEL=claude-opus-4-7

# --- Azure OpenAI (Realtime) ---
PA_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
PA_AZURE_OPENAI_API_KEY=
PA_AZURE_OPENAI_API_VERSION=2024-10-01-preview
PA_AZURE_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview

# --- Storage ---
PA_DATA_DIR=./data
