# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
PA_MODEL=claude-opus-4-7

# Storage
PA_DATA_DIR=./data
PA_DB_URL=sqlite+aiosqlite:///./data/pa.db

# API server
PA_HOST=127.0.0.1
PA_PORT=8765

# Logging
PA_LOG_LEVEL=INFO
PA_ENV=dev

# Memory bridge (claude-mem)
PA_CLAUDE_MEM_DIR=/Users/wanmeng/.claude/plugins/data/claude-mem-thedotmack

# Executor adapters (optional)
PA_TASKER_WEBHOOK=
PA_IOS_SHORTCUTS_WEBHOOK=
PA_WECHAT_GATEWAY_URL=
