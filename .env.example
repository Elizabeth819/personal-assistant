# --- API server ---
PA_HOST=127.0.0.1
PA_PORT=8765

# --- Logging ---
PA_LOG_LEVEL=INFO
PA_ENV=dev

# --- Memory bridge ---
PA_CLAUDE_MEM_DIR=/Users/wanmeng/.claude/plugins/data/claude-mem-thedotmack

# --- Executor adapters ---
PA_TASKER_WEBHOOK=
