# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
PA_MODEL=claude-opus-4-7

# --- Azure OpenAI (Realtime) ---
PA_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
PA_AZURE_OPENAI_API_KEY=
PA_AZURE_OPENAI_API_VERSION=2024-10-01-preview
PA_AZURE_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview
PA_AZURE_CHAT_DEPLOYMENT=gpt-4.1
PA_AZURE_WHISPER_DEPLOYMENT=whisper

# --- Storage ---
PA_DATA_DIR=./data
PA_DB_URL=sqlite+aiosqlite:///./data/pa.db

# --- API server ---
PA_HOST=127.0.0.1
PA_PORT=8765

# --- Logging ---
PA_LOG_LEVEL=INFO
PA_ENV=dev

# --- Memory bridge ---
PA_CLAUDE_MEM_DIR=/Users/wanmeng/.claude/plugins/data/claude-mem-thedotmack

# --- Executor adapters ---
PA_TASKER_WEBHOOK=
PA_IOS_SHORTCUTS_WEBHOOK=
PA_WECHAT_GATEWAY_URL=

# --- iPhone control (WebDriverAgent) ---
# USB mode (default): http://127.0.0.1:8100 — needs `iproxy 8100 8100`
# LAN mode (no Mac):  http://<iphone-lan-ip>:8100 — set after `xcodebuild test` boots WDA
PA_WDA_BASE_URL=http://127.0.0.1:8100
